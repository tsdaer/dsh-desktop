{
  "name": "@deepseek-ai/dsh-desktop-bridge-client",
  "version": "0.1.0",
  "private": true,
  "description": "Browser half of the shell bridge: forwards non-image drops to the bridge host route",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": { "platform": "web" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
