{
  "name": "@deepseek-ai/dsh-desktop",
  "version": "0.5.9",
  "private": true,
  "description": "Tauri 2 desktop shell that hosts the dsh web profile in a native window",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-bridge.mjs && node scripts/dev.mjs",
    "build": "node scripts/build-bridge.mjs && node scripts/dev.mjs --release",
    "bake": "node scripts/build-bridge.mjs && node scripts/bake-runtime.mjs",
    "fetch-node": "node scripts/fetch-node-sidecar.mjs",
    "evidence": "node scripts/build-bridge.mjs && node scripts/evidence-server.mjs",
    "test:evidence": "node --test scripts/evidence-server.spec.mjs",
    "packaged-smoke": "node scripts/packaged-smoke.mjs",
    "native-ui-smoke": "node scripts/tauri-ui-smoke.mjs",
    "update-smoke": "node scripts/update-smoke.mjs",
    "update-fixture": "node scripts/update-fixture.mjs",
    "linux-baseline": "node scripts/linux-baseline.mjs",
    "size-report": "node scripts/size-report.mjs",
    "size-check": "node scripts/size-report.mjs --check",
    "icons:check": "node scripts/gen-icons.mjs --check",
    "sync-version": "node scripts/sync-version.mjs",
    "version-check": "node scripts/sync-version.mjs --check",
    "bundle": "node scripts/bundle.mjs"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-updater": "^2.10.1"
  },
  "license": "MIT"
}
